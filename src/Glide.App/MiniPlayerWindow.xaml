<Window x:Class="Glide.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Glide.App.ViewModels"
        mc:Ignorable="d"
        Title="Glide Mini Player" Height="90" Width="380"
        Icon="pack://application:,,,/Glide.App;component/Assets/glide-icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Border Background="#121722" BorderBrush="{StaticResource GlideAccentMintBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12,8" SnapsToDevicePixels="True"
            MouseDown="Window_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Ícone / Logo do Glide Maior e Transparente -->
            <Image Source="pack://application:,,,/Glide.App;component/Assets/glide-logo.png" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center" />

            <!-- Metadados da Faixa -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTrack.Title}" Foreground="{StaticResource GlideTextPrimaryBrush}"
                           FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentTrack.Artist}" Foreground="{StaticResource GlideAccentMintBrush}"
                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="YouTube Music • Modo Eco" Foreground="{StaticResource GlideTextMutedBrush}" FontSize="10" />
            </StackPanel>

            <!-- Controles Rápidos com Ícones Vetoriais Nítidos -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="0" Margin="0,0,5,0" Command="{Binding PreviousTrackCommand}" ToolTip="Faixa Anterior">
                    <Path Data="{StaticResource GeoPrev}" Fill="{StaticResource GlideTextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <Button Width="34" Height="34" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="0" Margin="0,0,5,0" Command="{Binding TogglePlayPauseCommand}" ToolTip="Reproduzir / Pausar">
                    <Path Data="{Binding PlayPauseIconGeometry}" Fill="#0B0E14" Width="12" Height="12" Stretch="Uniform" />
                </Button>
                <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="0" Margin="0,0,8,0" Command="{Binding NextTrackCommand}" ToolTip="Próxima Faixa">
                    <Path Data="{StaticResource GeoNext}" Fill="{StaticResource GlideTextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                
                <!-- Expandir Janela Principal -->
                <Button Width="26" Height="26" Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="Abrir Janela Principal" Click="ExpandButton_Click">
                    <Path Data="{StaticResource GeoPopout}" Fill="{StaticResource GlideTextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" />
                </Button>
                
                <!-- Fechar Miniplayer -->
                <Button Content="✕" Width="26" Height="26" Style="{StaticResource WindowCloseButtonStyle}"
                        FontSize="11" ToolTip="Fechar Miniplayer" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

