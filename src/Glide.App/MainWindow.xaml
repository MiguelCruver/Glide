<Window x:Class="Glide.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Glide.App.ViewModels"
        xmlns:views="clr-namespace:Glide.App.Views"
        xmlns:enums="clr-namespace:Glide.Core.Enums;assembly=Glide.Core"
        mc:Ignorable="d"
        Title="Glide — Gaming Companion Hub" Height="740" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GlideBgBrush}"
        Foreground="{StaticResource GlideTextPrimaryBrush}"
        Icon="pack://application:,,,/Glide.App;component/Assets/glide-icon.ico"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" 
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoViewModel}">
            <views:VideoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectViewModel}">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource GlideBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de Título Customizada -->
            <Grid Grid.Row="0" Background="{StaticResource GlideSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Identidade no Topo Esquerdo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Glide.App;component/Assets/glide-logo.png" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="GLIDE" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="• Gaming Companion" Foreground="{StaticResource GlideTextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Pílula de Modo Gaming (Centro) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding ToggleGamingModeCommand}" Style="{x:Null}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <Border Background="#162520"
                                BorderBrush="{StaticResource GlideAccentMintBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource GlideAccentMintBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GamingModeStatusText}"
                                           Foreground="{StaticResource GlideAccentMintBrush}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Botões de Controle de Janela (Direita) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Botão Destacar Miniplayer -->
                    <Button Content="🗗 Miniplayer" Style="{StaticResource SecondaryButtonStyle}"
                            Height="26" FontSize="11" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center"
                            Click="MiniPlayerButton_Click" />

                    <!-- Minimizar, Maximizar, Fechar -->
                    <Button Content="&#xE921;" Style="{StaticResource WindowCaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimizar" />
                    <Button Content="&#xE922;" Style="{StaticResource WindowCaptionButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximizar" />
                    <Button Content="&#xE8BB;" Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Fechar (Recolhe para a bandeja)" />
                </StackPanel>
            </Grid>

            <!-- Área Principal (Sidebar + Conteúdo) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar Lateral -->
                <Border Grid.Column="0" Background="{StaticResource GlideSidebarGradient}"
                        BorderBrush="{StaticResource GlideBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,16,12,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Menu de Navegação -->
                        <StackPanel Grid.Row="0" Margin="0,6,0,0">
                            <TextBlock Text="MENU PRINCIPAL" Foreground="{StaticResource GlideTextMutedBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="14,0,0,12" />

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Home}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 8 2.5 L 1.5 8 L 3 8 L 3 14 H 6 V 10 H 10 V 14 H 13 V 8 L 14.5 8 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Início" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsAudioSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Audio}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12 3 V 10.5 A 2.5 2.5 0 1 1 9.5 8 H 10 V 5 L 4 6.5 V 12.5 A 2.5 2.5 0 1 1 1.5 10 H 2 V 4.5 L 12 2 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Áudio &amp; Música" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsVideoSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Video}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2 3 H 14 C 14.6 3 15 3.4 15 4 V 12 C 15 12.6 14.6 13 14 13 H 2 C 1.4 13 1 12.6 1 12 V 4 C 1 3.4 1.4 3 2 3 Z M 6 5.5 V 10.5 L 10.5 8 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Vídeo &amp; Streaming" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsNotificationsSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Notifications}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2 2.5 H 14 C 14.6 2.5 15 2.9 15 3.5 V 10.5 C 15 11.1 14.6 11.5 14 11.5 H 5.5 L 2 14.5 V 3.5 C 2 2.9 2.4 2.5 3 2.5 Z M 4 5 H 12 V 6.5 H 4 Z M 4 8 H 9.5 V 9.5 H 4 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Central &amp; Mensagens" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsConnectSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Connect}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 8 2 C 6.9 2 6 2.9 6 4 V 8 C 6 9.1 6.9 10 8 10 C 9.1 10 10 9.1 10 8 V 4 C 10 2.9 9.1 2 8 2 Z M 12 7 V 8 C 12 10.2 10.2 12 8 12 C 5.8 12 4 10.2 4 8 V 7 H 2.5 V 8 C 2.5 10.7 4.5 13 7.2 13.4 V 15 H 5 V 16.5 H 11 V 15 H 8.8 V 13.4 C 11.5 13 13.5 10.7 13.5 8 V 7 H 12 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Glide Connect" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Border Height="1" Background="{StaticResource GlideBorderSubtleBrush}" Margin="8,16,8,16" />

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="{x:Static enums:GlideModule.Settings}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 8 5 A 3 3 0 1 0 8 11 A 3 3 0 1 0 8 5 Z M 9.5 1.5 L 9.1 3.2 C 9.7 3.5 10.2 3.8 10.7 4.2 L 12.4 3.5 L 13.5 5.4 L 12 6.5 C 12.1 6.8 12.1 7.1 12.1 7.5 C 12.1 7.9 12.1 8.2 12 8.5 L 13.5 9.6 L 12.4 11.5 L 10.7 10.8 C 10.2 11.2 9.7 11.5 9.1 11.8 L 9.5 13.5 H 7.3 L 6.9 11.8 C 6.3 11.5 5.8 11.2 5.3 10.8 L 3.6 11.5 L 2.5 9.6 L 4 8.5 C 3.9 8.2 3.9 7.9 3.9 7.5 C 3.9 7.1 3.9 6.8 4 6.5 L 2.5 5.4 L 3.6 3.5 L 5.3 4.2 C 5.8 3.8 6.3 3.5 6.9 3.2 L 7.3 1.5 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Width="15" Height="15" Stretch="Uniform" Margin="4,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Configurações" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Barra de Faixa Rápida na Base da Sidebar -->
                        <Border Grid.Row="1" Background="#161D2A" BorderBrush="{StaticResource GlideBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding CurrentTrack.Title}" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                               FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CurrentTrack.Artist}" Foreground="{StaticResource GlideAccentMintBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0" Margin="0,0,6,0" Command="{Binding PreviousTrackCommand}" ToolTip="Faixa Anterior">
                                        <Path Data="{StaticResource GeoPrev}" Fill="{StaticResource GlideTextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                    </Button>
                                    <Button Width="32" Height="32" Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="0" Margin="0,0,6,0" Command="{Binding TogglePlayPauseCommand}" ToolTip="Reproduzir / Pausar">
                                        <Path Data="{Binding PlayPauseIconGeometry}" Fill="#0B0E14" Width="12" Height="12" Stretch="Uniform" />
                                    </Button>
                                    <Button Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="0" Command="{Binding NextTrackCommand}" ToolTip="Próxima Faixa">
                                        <Path Data="{StaticResource GeoNext}" Fill="{StaticResource GlideTextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- Host Dinâmico de Conteúdo -->
                <Grid Grid.Column="1" Background="{StaticResource GlideBgBrush}">
                    <ContentControl Content="{Binding CurrentView}" />
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
