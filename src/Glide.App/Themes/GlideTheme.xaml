<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Base do Design System Glide (Alinhadas à Logo Oficial) -->
    <Color x:Key="GlideBgColor">#0B0E14</Color>
    <Color x:Key="GlideSurfaceColor">#121722</Color>
    <Color x:Key="GlideCardColor">#161D2A</Color>
    <Color x:Key="GlideCardHoverColor">#1E2738</Color>
    <Color x:Key="GlideCardSelectedColor">#24334A</Color>
    <Color x:Key="GlideBorderColor">#243042</Color>
    <Color x:Key="GlideBorderSubtleColor">#1A2330</Color>

    <Color x:Key="GlideAccentMintColor">#00F2A5</Color>
    <Color x:Key="GlideAccentBlueColor">#38BDF8</Color>
    <Color x:Key="GlideAccentElectricColor">#2563EB</Color>

    <Color x:Key="GlideTextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="GlideTextSecondaryColor">#94A3B8</Color>
    <Color x:Key="GlideTextMutedColor">#64748B</Color>

    <Color x:Key="GlideSuccessColor">#10B981</Color>
    <Color x:Key="GlideWarningColor">#F59E0B</Color>
    <Color x:Key="GlideDangerColor">#EF4444</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="GlideBgBrush" Color="{StaticResource GlideBgColor}" />
    <SolidColorBrush x:Key="GlideSurfaceBrush" Color="{StaticResource GlideSurfaceColor}" />
    <SolidColorBrush x:Key="GlideCardBrush" Color="{StaticResource GlideCardColor}" />
    <SolidColorBrush x:Key="GlideCardHoverBrush" Color="{StaticResource GlideCardHoverColor}" />
    <SolidColorBrush x:Key="GlideCardSelectedBrush" Color="{StaticResource GlideCardSelectedColor}" />
    <SolidColorBrush x:Key="GlideBorderBrush" Color="{StaticResource GlideBorderColor}" />
    <SolidColorBrush x:Key="GlideBorderSubtleBrush" Color="{StaticResource GlideBorderSubtleColor}" />

    <SolidColorBrush x:Key="GlideAccentMintBrush" Color="{StaticResource GlideAccentMintColor}" />
    <SolidColorBrush x:Key="GlideAccentBlueBrush" Color="{StaticResource GlideAccentBlueColor}" />
    <SolidColorBrush x:Key="GlideAccentElectricBrush" Color="{StaticResource GlideAccentElectricColor}" />

    <SolidColorBrush x:Key="GlideTextPrimaryBrush" Color="{StaticResource GlideTextPrimaryColor}" />
    <SolidColorBrush x:Key="GlideTextSecondaryBrush" Color="{StaticResource GlideTextSecondaryColor}" />
    <SolidColorBrush x:Key="GlideTextMutedBrush" Color="{StaticResource GlideTextMutedColor}" />

    <SolidColorBrush x:Key="GlideSuccessBrush" Color="{StaticResource GlideSuccessColor}" />
    <SolidColorBrush x:Key="GlideWarningBrush" Color="{StaticResource GlideWarningColor}" />
    <SolidColorBrush x:Key="GlideDangerBrush" Color="{StaticResource GlideDangerColor}" />

    <!-- Gradientes de Marca Glide -->
    <LinearGradientBrush x:Key="GlideBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F2A5" Offset="0.0" />
        <GradientStop Color="#10E7B0" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlideSidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#121722" Offset="0.0" />
        <GradientStop Color="#0D111A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Geometrias Vetoriais dos Ícones de Mídia e Controles (Alta Nitidez) -->
    <Geometry x:Key="GeoPlay">M 3 2 L 13 8 L 3 14 Z</Geometry>
    <Geometry x:Key="GeoPause">M 3 2 H 6 V 14 H 3 Z M 10 2 H 13 V 14 H 10 Z</Geometry>
    <Geometry x:Key="GeoNext">M 2 2 L 9 8 L 2 14 Z M 11 2 H 13 V 14 H 11 Z</Geometry>
    <Geometry x:Key="GeoPrev">M 13 2 L 6 8 L 13 14 Z M 2 2 H 4 V 14 H 2 Z</Geometry>
    <Geometry x:Key="GeoVolume">M 1 5 H 4 L 8 2 V 14 L 4 11 H 1 Z M 10 5 A 4 4 0 0 1 10 11 M 12 3 A 7 7 0 0 1 12 13</Geometry>
    <Geometry x:Key="GeoPopout">M 2 2 H 9 V 4 H 4 V 12 H 12 V 7 H 14 V 14 H 2 Z M 8 2 H 14 V 8 L 12 6 L 8 10 L 6 8 L 10 4 Z</Geometry>
    <Geometry x:Key="GeoMiniPlayer">M 2 2 H 14 V 14 H 2 Z M 5 5 H 11 V 11 H 5 Z</Geometry>

    <!-- Botões da Sidebar de Navegação -->
    <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GlideTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="8" Padding="14,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Indicador ativo -->
                            <Rectangle x:Name="activeIndicator" Width="3" Height="20" HorizontalAlignment="Left"
                                       Fill="{StaticResource GlideAccentMintBrush}" RadiusX="1.5" RadiusY="1.5"
                                       Visibility="Collapsed" Margin="-14,0,0,0"/>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1A2332" />
                            <Setter Property="Foreground" Value="{StaticResource GlideTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1C2738" />
                            <Setter Property="Foreground" Value="{StaticResource GlideAccentMintBrush}" />
                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão Primário (Gradiente Neon Glide) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GlideAccentMintBrush}" />
        <Setter Property="Foreground" Value="#0B0E14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#10E7B0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#00C985" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão Secundário (Outline) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#161D2A" />
        <Setter Property="Foreground" Value="{StaticResource GlideTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlideBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#222C3D" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlideAccentBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#151C28" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões da Barra de Título (Minimizar, Maximizar, Fechar) -->
    <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GlideTextSecondaryBrush}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#243042" />
                            <Setter Property="Foreground" Value="{StaticResource GlideTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Estilizado com Borda Sutil -->
    <Style x:Key="GlideCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlideCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlideBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Caixa de Texto Estilizada Dark -->
    <Style x:Key="GlideTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#121722" />
        <Setter Property="Foreground" Value="{StaticResource GlideTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlideBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource GlideAccentMintBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlideAccentMintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

