<UserControl x:Class="Glide.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,30">
            
            <TextBlock Text="Configurações &amp; Perfil do Jogador" Foreground="{StaticResource GlideTextPrimaryBrush}"
                       FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Personalize sua identidade, regras de segurança, comportamento de segundo plano e aceleração de hardware."
                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="13" Margin="0,0,0,24" />

            <!-- SEÇÃO 1: PERFIL DO JOGADOR (BANNER, AVATAR, NICK, STATUS) -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Banner do Perfil -->
                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource GlideSidebarGradient}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Source="{Binding BannerPath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="📷 Alterar Banner" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" FontSize="11" Padding="10,4"
                                Click="ChangeBannerBtn_Click" />
                    </Grid>

                    <!-- Informações do Jogador & Avatar -->
                    <Grid Grid.Row="1" Margin="20,-34,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Avatar Sobreposto ao Banner -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="68" Height="68" CornerRadius="34" Background="#121722"
                                    BorderBrush="{StaticResource GlideAccentMintBrush}" BorderThickness="2"
                                    ClipToBounds="True" Margin="0,0,16,0">
                                <Grid>
                                    <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <Button Content="Alterar Foto" Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="10,4" Click="ChangeAvatarBtn_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Inputs de Nick e Status -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nick / Nome no Glide Connect" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding ProfileNick, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GlideTextBoxStyle}" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Status / Frase de Exibição" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding ProfileStatus, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource GlideTextBoxStyle}" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Ações do Perfil -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="Salvar Alterações de Perfil" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveProfileCommand}" Height="34" Padding="16,0" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding SaveProfileFeedback}" Foreground="{StaticResource GlideAccentMintBrush}"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- SEÇÃO 2: DESEMPENHO E MODO GAMING -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Desempenho &amp; Otimização de Hardware" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Suspensão agressiva de WebViews ociosas (Modo Eco Automático)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Suspende automaticamente a renderização de vídeo e abas em segundo plano para poupar 100% de GPU para o jogo."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoEcoModeInBackground}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Detecção inteligente de jogos (CS2, Valorant, etc.)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Ativa o Modo Gaming prioritário e silencia pop-ups automaticamente ao detectar jogos em tela cheia."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding GamingModeAuto}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Aceleração de Hardware GPU (AMD Radeon RX 7600)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Utiliza decodificadores dedicados da placa de vídeo para reprodução de mídia sem engasgos de CPU."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding HardwareAcceleration}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SEÇÃO 4: JANELA E BANDEJA DO SISTEMA -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Janela e Comportamento do Sistema" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Recolher para a bandeja ao fechar (X)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Mantém músicas e chamadas ativas na bandeja do Windows ao clicar em fechar."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Iniciar minimizado na bandeja" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Inicia silenciosamente junto com o Windows sem abrir a janela na tela."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SEÇÃO 5: COMUNICAÇÃO & PUSH TO TALK -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Voz e Tecla de Transmissão (Push to Talk)" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Modo Push-to-Talk (Pressionar para Falar)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Transmite áudio no Glide Connect apenas enquanto a tecla designada estiver pressionada."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding PushToTalkEnabled}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tecla de Atalho do Push-to-Talk" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Tecla padrão do teclado para comunicação rápida durante os tiroteios."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#121722" BorderBrush="{StaticResource GlideBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,6">
                            <TextBlock Text="{Binding PushToTalkKey, StringFormat='Tecla: [{0}]'}" Foreground="{StaticResource GlideAccentMintBrush}"
                                       FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SEÇÃO 6: MANUTENÇÃO E LIMPEZA DE DADOS -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Manutenção &amp; Limpeza" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="15" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Limpar Cache do Navegador (WebView2)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Libera espaço em disco apagando arquivos temporários e cache de streaming sem deslogar suas contas."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Limpar Cache" Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="11" Padding="12,5" Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Restaurar Configurações Padrão" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Redefine preferências de inicialização, modo gaming e atalhos para os valores originais."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restaurar Padrões" Style="{StaticResource SecondaryButtonStyle}"
                                Foreground="{StaticResource GlideDangerBrush}" FontSize="11" Padding="12,5" Command="{Binding ResetDefaultsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SEÇÃO 7: ATUALIZAÇÕES DO APLICATIVO (IN-APP UPDATER GITHUB) -->
            <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Atualizações do Sistema" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Verifique novas versões publicadas no repositório oficial do GitHub e atualize diretamente com 1 clique."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Verificar Atualizações" Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" FontSize="11" Padding="14,0" Command="{Binding CheckForUpdateCommand}"
                                IsEnabled="{Binding CanCheckForUpdate}" />
                    </Grid>

                    <!-- Status da Versão Atual -->
                    <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentVersionText, StringFormat='Versão Instalada: {0}'}"
                                           Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdateStatusMessage}" Foreground="{StaticResource GlideTextMutedBrush}"
                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#162232" BorderBrush="{StaticResource GlideAccentBlueBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="OFICIAL GITHUB" Foreground="{StaticResource GlideAccentBlueBrush}" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Banner de Atualização Disponível (Quando detectada nova release) -->
                    <Border BorderBrush="{StaticResource GlideAccentMintBrush}" BorderThickness="1"
                            Background="#142621" CornerRadius="8" Padding="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding LatestVersionTag, StringFormat='🎉 Nova Versão Disponível: {0}'}"
                                               Foreground="{StaticResource GlideAccentMintBrush}" FontSize="13" FontWeight="Bold" />
                                    <TextBlock Text="O instalador oficial foi localizado. Clique ao lado para baixar e reiniciar o Glide."
                                               Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="🚀 Baixar e Atualizar" Style="{StaticResource PrimaryButtonStyle}"
                                        Height="32" Padding="14,0" Command="{Binding InstallUpdateCommand}"
                                        IsEnabled="{Binding CanInstallUpdate}" />
                            </Grid>

                            <!-- Barra de Progresso do Download -->
                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercentage}"
                                             Height="6" Background="#0C1410" Foreground="{StaticResource GlideAccentMintBrush}"
                                             BorderThickness="0" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding DownloadProgressPercentage, StringFormat='Baixando: {0}%'}"
                                           Foreground="{StaticResource GlideAccentMintBrush}" FontSize="10" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SEÇÃO FINAL: ISOLAMENTO DE SEGURANÇA (COM CONFIRMAÇÃO OBRIGATÓRIA) -->
            <Border BorderBrush="{StaticResource GlideDangerBrush}" BorderThickness="1"
                    Background="#16131A" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Isolamento Estrito de Segurança (Sandbox de Domínios)" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Proteção ativa contra redirecionamentos não autorizados e abertura de pop-ups maliciosos fora das allowlists oficiais."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" />
                        </StackPanel>

                        <!-- Switch de Segurança com Bloqueio de Confirmação -->
                        <CheckBox Grid.Column="1" IsChecked="{Binding StrictSecurityMode}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="#201518" BorderBrush="#3D2024" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="⚠️ Aviso: Desativar esta opção permite navegação externa livre mas remove o isolamento de proteção contra malvertising durante partidas. A desativação requer confirmação expressa."
                                   Foreground="{StaticResource GlideWarningBrush}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- SOBRE O GLIDE -->
            <Border Background="#101824" BorderBrush="{StaticResource GlideBorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Glide — Gaming Companion Hub v2.0" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Arquitetura de alto desempenho em .NET 8 LTS com WebView2 isolado e áudio nativo." Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Build 28.10.2026 • Windows 11 Ready" Foreground="{StaticResource GlideAccentMintBrush}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
