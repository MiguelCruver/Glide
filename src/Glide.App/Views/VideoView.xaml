<UserControl x:Class="Glide.App.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900"
             Loaded="UserControl_Loaded">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de Ferramentas: Seletor de Serviços + Navegação Web -->
        <Border Grid.Row="0" Style="{StaticResource GlideCardBorderStyle}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Botões de Histórico e Recarregar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="◀" Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11" Padding="0" Margin="0,0,4,0" Click="BackButton_Click" ToolTip="Voltar" />
                    <Button Content="▶" Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11" Padding="0" Margin="0,0,4,0" Click="ForwardButton_Click" ToolTip="Avançar" />
                    <Button Content="⟳" Width="28" Height="28" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="13" Padding="0" Click="ReloadButton_Click" ToolTip="Recarregar" />
                </StackPanel>

                <!-- Seletor Segmentado: YouTube | Instagram | X (Twitter) -->
                <Border Grid.Column="1" Background="#101724" BorderBrush="{StaticResource GlideBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="YouTubeTabBtn" Content="▶️ YouTube"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="28" FontSize="11" Padding="12,0" Margin="0,0,4,0"
                                Click="YouTubeTabBtn_Click" />
                        <Button x:Name="InstagramTabBtn" Content="📸 Instagram"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" FontSize="11" Padding="12,0" Margin="0,0,4,0"
                                Click="InstagramTabBtn_Click" />
                        <Button x:Name="TwitterTabBtn" Content="𝕏 X (Twitter)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="28" FontSize="11" Padding="12,0"
                                Click="TwitterTabBtn_Click" />
                    </StackPanel>
                </Border>

                <!-- Status do Provedor Ativo -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="VideoServiceNameTxt" Text="YouTube" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#1A2D28" BorderBrush="{StaticResource GlideAccentMintBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="VISUALIZAÇÃO PRINCIPAL" Foreground="{StaticResource GlideAccentMintBrush}" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Ações: Popout para Janela Flutuante / Suspender -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="32" Height="30" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="0" Margin="0,0,8,0" Click="PopoutButton_Click" ToolTip="Destacar em Janela Flutuante (2º Monitor)">
                        <Path Data="{StaticResource GeoPopout}" Fill="{StaticResource GlideTextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Content="{Binding SuspendButtonText}"
                            Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="12,4"
                            Click="SuspendButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Container do WebView2 do Vídeo -->
        <Border Grid.Row="1" Style="{StaticResource GlideCardBorderStyle}" Padding="0" ClipToBounds="True" Background="#000000">
            <Grid>
                <!-- WebView2 Live Player -->
                <wv2:WebView2 x:Name="VideoWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Painel de Suspensão / Economia de Recursos -->
                <Border x:Name="SuspendedOverlay" Background="#0C1017" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏸" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{StaticResource GlideAccentMintBrush}" />
                        <TextBlock Text="Módulo em Espera (RAM e GPU Liberadas)" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="O WebView foi suspenso para garantir o máximo de FPS no jogo." Foreground="{StaticResource GlideTextMutedBrush}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Content="Retomar Visualização" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                                Click="ResumeButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Indicador de Carregamento Inicial -->
                <Border x:Name="LoadingOverlay" Background="#0C1017" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" Foreground="{StaticResource GlideAccentMintBrush}"
                                     Background="#1A2332" BorderThickness="0" Margin="0,0,0,12" />
                        <TextBlock x:Name="LoadingText" Text="Carregando..." Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
