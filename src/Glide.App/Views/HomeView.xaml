<UserControl x:Class="Glide.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:Glide.Core.Enums;assembly=Glide.Core"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,30">
            
            <!-- Hero Banner -->
            <Border Background="{StaticResource GlideCardBrush}"
                    BorderBrush="{StaticResource GlideBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo Oficial em Destaque (Fundo Transparente) -->
                    <Image Grid.Column="0" Source="pack://application:,,,/Glide.App;component/Assets/glide-logo.png"
                           Width="102" Height="102" Margin="0,0,24,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#1A2D28" BorderBrush="{StaticResource GlideAccentMintBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,10,0">
                                <TextBlock Text="GAMING COMPANION HUB" Foreground="{StaticResource GlideAccentMintBrush}"
                                           FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Border Background="#1B263B" BorderBrush="{StaticResource GlideAccentBlueBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="WINDOWS 11 / CS2 READY" Foreground="{StaticResource GlideAccentBlueBrush}"
                                           FontSize="11" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Bem-vindo ao Glide" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                   FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="Central ultraleve de mídia, comunicação e chamadas privadas para o seu setup sem interferir no frametime dos seus jogos."
                                   Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="600" />
                    </StackPanel>

                    <!-- Status de Recursos em Tempo Real -->
                    <Border Grid.Column="2" Background="{StaticResource GlideSurfaceBrush}" 
                            BorderBrush="{StaticResource GlideBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Center" MinWidth="220">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource GlideAccentMintBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="DESEMPENHO EM TEMPO REAL" Foreground="{StaticResource GlideAccentMintBrush}"
                                           FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding RamDisplayText}" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CpuDisplayText}" Foreground="{StaticResource GlideAccentMintBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding UptimeDisplayText, StringFormat='Atividade: {0}'}" Foreground="{StaticResource GlideAccentBlueBrush}"
                                       FontSize="11" FontWeight="Normal" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Título da Seção -->
            <TextBlock Text="Módulos Rápidos" Foreground="{StaticResource GlideTextPrimaryBrush}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

            <!-- Grid de 4 Módulos -->
            <UniformGrid Columns="2" Margin="-8,0,-8,0">

                <!-- Card Áudio -->
                <Border Style="{StaticResource GlideCardBorderStyle}" Margin="8" MinHeight="170">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🎵" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Áudio &amp; Música" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource GlideTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Reprodução leve de YouTube Music e Spotify sem carregar elementos gráficos pesados durante as partidas."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="Acessar Áudio" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:GlideModule.Audio}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card Vídeo -->
                <Border Style="{StaticResource GlideCardBorderStyle}" Margin="8" MinHeight="170">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="▶️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Vídeo &amp; Redes Sociais" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource GlideTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Acesso nativo a YouTube, Instagram e X (Twitter) diretamente no hub ou destacado em janela flutuante no 2º monitor."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="Abrir Vídeo &amp; Redes" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:GlideModule.Video}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card Central de Notificações -->
                <Border Style="{StaticResource GlideCardBorderStyle}" Margin="8" MinHeight="170">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="📬" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Central de Notificações" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource GlideTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Alertas do sistema, convites de salas do Glide Connect e eventos de gaming com baixíssimo consumo de memória."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="Ver Notificações" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:GlideModule.Notifications}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card Glide Connect -->
                <Border Style="{StaticResource GlideCardBorderStyle}" Margin="8" MinHeight="170">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🎙️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Glide Connect" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource GlideTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Salas de voz ultraleve, transmissão por hardware e chat privado com histórico 100% no seu PC (SQLite local)."
                                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="Entrar no Connect" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Command="{Binding NavigateCommand}"
                                    CommandParameter="{x:Static enums:GlideModule.Connect}" />
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Seção: Conectar Contas & Integrações -->
            <TextBlock Text="Conectar Contas &amp; Sincronização" Foreground="{StaticResource GlideTextPrimaryBrush}"
                       FontSize="18" FontWeight="Bold" Margin="0,24,0,4" />
            <TextBlock Text="Conecte seus serviços favoritos para sincronizar músicas, vídeos, amigos da Steam e redes sociais com um clique."
                       Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" />

            <Border Style="{StaticResource GlideCardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="3" Margin="-6,0,-6,12">
                        <!-- 1. Google (YouTube, YT Music, Gmail) -->
                        <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Conta Google" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="YouTube, YouTube Music e Gmail sincronizados com login único."
                                           Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
                                
                                <Button Grid.Row="2" Content="Conectar Google"
                                        Height="30" FontSize="11"
                                        Command="{Binding ConnectServiceCommand}" CommandParameter="google">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoogleConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoogleConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✓ Abrir" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding ConnectServiceCommand}" CommandParameter="google" />
                                    <Button Grid.Column="1" Content="Desconectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Foreground="{StaticResource GlideDangerBrush}" Height="30" FontSize="10" Padding="8,0"
                                            Command="{Binding DisconnectServiceCommand}" CommandParameter="google" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2. Spotify -->
                        <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎧" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Spotify" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Playlists, podcasts e controles de reprodução direta no miniplayer."
                                           Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Button Grid.Row="2" Content="Conectar Spotify"
                                        Height="30" FontSize="11"
                                        Command="{Binding ConnectServiceCommand}" CommandParameter="spotify">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpotifyConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpotifyConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✓ Abrir" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding ConnectServiceCommand}" CommandParameter="spotify" />
                                    <Button Grid.Column="1" Content="Desconectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Foreground="{StaticResource GlideDangerBrush}" Height="30" FontSize="10" Padding="8,0"
                                            Command="{Binding DisconnectServiceCommand}" CommandParameter="spotify" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 3. Steam -->
                        <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Steam Community" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Status de amigos, convites de lobby e notificações de updates do CS2."
                                           Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Button Grid.Row="2" Content="Conectar Steam"
                                        Height="30" FontSize="11"
                                        Command="{Binding ConnectServiceCommand}" CommandParameter="steam">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSteamConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSteamConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✓ Abrir" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding ConnectServiceCommand}" CommandParameter="steam" />
                                    <Button Grid.Column="1" Content="Desconectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Foreground="{StaticResource GlideDangerBrush}" Height="30" FontSize="10" Padding="8,0"
                                            Command="{Binding DisconnectServiceCommand}" CommandParameter="steam" />
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="-6,0,-6,0">
                        <!-- 4. Instagram -->
                        <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📸" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Instagram" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Acesso a reels, direct messages e feed durante pausas ou no 2º monitor."
                                           Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Button Grid.Row="2" Content="Conectar Instagram"
                                        Height="30" FontSize="11"
                                        Command="{Binding ConnectServiceCommand}" CommandParameter="instagram">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstagramConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstagramConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✓ Abrir" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding ConnectServiceCommand}" CommandParameter="instagram" />
                                    <Button Grid.Column="1" Content="Desconectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Foreground="{StaticResource GlideDangerBrush}" Height="30" FontSize="10" Padding="8,0"
                                            Command="{Binding DisconnectServiceCommand}" CommandParameter="instagram" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 5. X (Twitter) -->
                        <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🕇" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="X (Twitter)" Foreground="{StaticResource GlideTextPrimaryBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="Notícias de esports, clipes da comunidade e tendências em tempo real."
                                           Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <Button Grid.Row="2" Content="Conectar X (Twitter)"
                                        Height="30" FontSize="11"
                                        Command="{Binding ConnectServiceCommand}" CommandParameter="twitter">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTwitterConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid Grid.Row="2">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTwitterConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="✓ Abrir" Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding ConnectServiceCommand}" CommandParameter="twitter" />
                                    <Button Grid.Column="1" Content="Desconectar" Style="{StaticResource SecondaryButtonStyle}"
                                            Foreground="{StaticResource GlideDangerBrush}" Height="30" FontSize="10" Padding="8,0"
                                            Command="{Binding DisconnectServiceCommand}" CommandParameter="twitter" />
                                </Grid>
                            </Grid>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

