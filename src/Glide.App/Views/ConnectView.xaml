<UserControl x:Class="Glide.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho do Glide Connect -->
        <Border Grid.Row="0" Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,16" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🎙️ GLIDE CONNECT" Foreground="{StaticResource GlideAccentMintBrush}"
                                   FontSize="18" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        
                        <!-- Badge Quando Conectado -->
                        <Border Background="#1A2D28" BorderBrush="{StaticResource GlideAccentMintBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RoomCode, StringFormat='🟢 CONECTADO NA SALA {0}'}" Foreground="{StaticResource GlideAccentMintBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>

                        <!-- Badge Quando Desconectado -->
                        <Border Background="#251C1A" BorderBrush="{StaticResource GlideWarningBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⚪ FORA DE UMA SALA" Foreground="{StaticResource GlideWarningBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Comunicação de voz direta, histórico SQLite 100% no seu PC e compartilhamento de imagens."
                               Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <!-- Painel de Ações: QUANDO NÃO ESTÁ EM SALA (Entrar ou Criar) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBox Text="{Binding TargetRoomCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource GlideTextBoxStyle}" Width="140" Height="34"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"
                             ToolTip="Digite o código da sala (ex: GLIDE-1234)" />

                    <Button Content="➜ Entrar na Sala" Style="{StaticResource PrimaryButtonStyle}"
                            Height="34" FontSize="11" Padding="12,0" Margin="0,0,8,0"
                            Command="{Binding JoinRoomCommand}" ToolTip="Ingressar na sala com o código digitado" />

                    <Button Content="➕ Criar Nova Sala" Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" FontSize="11" Padding="12,0"
                            Command="{Binding CreateRoomCommand}" ToolTip="Criar uma sala privada instantânea com novo código" />
                </StackPanel>

                <!-- Painel de Ações: QUANDO JÁ ESTÁ CONECTADO NA SALA -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInRoom}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#121722" BorderBrush="{StaticResource GlideBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Sala: " Foreground="{StaticResource GlideTextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RoomCode}" Foreground="{StaticResource GlideAccentBlueBrush}"
                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Content="📋 Copiar Código" Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" FontSize="11" Padding="10,0" Margin="0,0,8,0"
                            Command="{Binding CopyRoomCodeCommand}" ToolTip="Copiar código para enviar a amigos" />

                    <Button Content="🚪 Sair da Sala" Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" FontSize="11" Padding="10,0" Margin="0,0,8,0"
                            Command="{Binding LeaveRoomCommand}" ToolTip="Desconectar-se da sala atual" />

                    <Button Content="🗑️ Limpar Sala" Style="{StaticResource SecondaryButtonStyle}"
                            Foreground="{StaticResource GlideDangerBrush}" Height="34" FontSize="11" Padding="10,0"
                            Command="{Binding ClearHistoryCommand}" ToolTip="Apagar mensagens e anexos locais desta sala" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área Principal: Participantes (Esquerda) e Chat com Histórico Local (Direita) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Painel de Participantes e Voz -->
            <Border Grid.Column="0" Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,14,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Participantes na Sala" Foreground="{StaticResource GlideTextPrimaryBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                    <!-- Lista de Participantes -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Participants}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Indicador de Fala em Tempo Real -->
                                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#222B3A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource GlideAccentMintBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Avatar ou Ícone do Participante -->
                                        <Border Width="26" Height="26" CornerRadius="13" Background="#1B2433"
                                                BorderBrush="{StaticResource GlideBorderBrush}" BorderThickness="1"
                                                ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="👤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource GlideTextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <!-- Status de Áudio -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔊" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource GlideTextSecondaryBrush}" />
                                            <TextBlock Text="🎤" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource GlideAccentMintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource GlideDangerBrush}" />
                                                                <Setter Property="Text" Value="🔇" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Barra de Controles de Áudio do Usuário -->
                    <Border Grid.Row="2" Background="#0E131C" BorderBrush="{StaticResource GlideBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <!-- VU Meter do Microfone em Tempo Real -->
                            <TextBlock Text="Sensibilidade do Microfone" Foreground="{StaticResource GlideTextMutedBrush}"
                                       FontSize="10" Margin="0,0,0,4" />
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding MicLevel, Mode=OneWay}"
                                         Height="4" Background="#161E2C" Foreground="{StaticResource GlideAccentMintBrush}"
                                         BorderThickness="0" Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Button Content="{Binding MuteButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding ToggleMuteCommand}" FontSize="11" Padding="10,5" />
                                <Button Content="{Binding DeafenButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleDeafenCommand}" FontSize="11" Padding="10,5" />
                            </StackPanel>
                            <Button Content="{Binding ScreenShareButtonText}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ToggleScreenShareCommand}" FontSize="11" Padding="10,6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Painel de Chat em Tempo Real com Histórico 100% Local (SQLite) -->
            <Border Grid.Column="1" Style="{StaticResource GlideCardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header do Chat com Aviso de Privacidade -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Chat Privado da Sala" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                       FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Histórico mantido localmente em SQLite no seu computador. Nenhuma mensagem gravada em servidores remotos."
                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="11" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="🗑️ Limpar Histórico Local" Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="10" Padding="8,4" Command="{Binding ClearHistoryCommand}" />
                    </Grid>

                    <!-- Lista de Mensagens -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121722" BorderBrush="{StaticResource GlideBorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                            HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SenderName}" Foreground="{StaticResource GlideAccentMintBrush}"
                                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Content}" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                                           FontSize="13" TextWrapping="Wrap" />

                                                <!-- Imagem em Anexo -->
                                                <Border Margin="0,6,0,0" CornerRadius="6" ClipToBounds="True" Background="#0C1017"
                                                        HorizontalAlignment="Left" MaxWidth="280">
                                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" MaxHeight="160" />
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                                       Foreground="{StaticResource GlideTextMutedBrush}" FontSize="10"
                                                       VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Campo de Entrada de Mensagem -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="📎" Style="{StaticResource SecondaryButtonStyle}"
                                Width="38" Height="38" FontSize="16" Margin="0,0,8,0" Padding="0"
                                Click="AttachButton_Click" ToolTip="Enviar Imagem (.png, .jpg)" />
                        <TextBox Grid.Column="1" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource GlideTextBoxStyle}" Height="38"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 KeyDown="ChatInput_KeyDown" />
                        <Button Grid.Column="2" Content="Enviar" Style="{StaticResource PrimaryButtonStyle}"
                                Height="38" Padding="16,0" Command="{Binding SendMessageCommand}" />
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- Rodapé Informativo: Status P2P & Limitações Documentadas -->
        <Border Grid.Row="2" Background="#101824" BorderBrush="{StaticResource GlideBorderSubtleBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ Modo de Conectividade:" Foreground="{StaticResource GlideTextMutedBrush}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Conexão Segura / Microfone NAudio Ativo" Foreground="{StaticResource GlideAccentBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Banco de Dados Local SQLite Ativo • Histórico em Disco"
                           Foreground="{StaticResource GlideAccentMintBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
