<UserControl x:Class="Glide.App.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,30">
            
            <!-- Cabeçalho -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Central de Notificações &amp; Alertas" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                   FontSize="22" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Background="#1A2D28" BorderBrush="{StaticResource GlideAccentMintBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnreadCount, StringFormat='{}{0} NÃO LIDAS'}"
                                       Foreground="{StaticResource GlideAccentMintBrush}" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Central de mensagens agregadas do setup com filtragem por categoria e histórico em tempo real."
                               Foreground="{StaticResource GlideTextSecondaryBrush}" FontSize="13" />
                </StackPanel>

                <!-- Ações do Topo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Simular Alerta" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11" Padding="10,5" Margin="0,0,8,0" Command="{Binding SimulateNotificationCommand}"
                            ToolTip="Gera uma notificação de teste em tempo real" />
                    <Button Content="{Binding DndButtonText}" Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11" Padding="10,5" Margin="0,0,8,0" Command="{Binding ToggleDoNotDisturbCommand}" />
                    <Button Content="✓ Marcar Lidas" Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="11" Padding="12,5" Command="{Binding MarkAllAsReadCommand}" />
                </StackPanel>
            </Grid>

            <!-- Filtros por Categoria -->
            <Border Background="#101724" BorderBrush="{StaticResource GlideBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Todas as Mensagens"
                            Height="28" FontSize="11" Padding="12,0" Margin="0,0,4,0"
                            Command="{Binding FilterCommand}" CommandParameter="Todas">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GlideAccentMintBrush}" />
                                        <Setter Property="Foreground" Value="#0B0E14" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🎮 Jogos &amp; Steam"
                            Height="28" FontSize="11" Padding="12,0" Margin="0,0,4,0"
                            Command="{Binding FilterCommand}" CommandParameter="Jogos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterGames}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GlideAccentMintBrush}" />
                                        <Setter Property="Foreground" Value="#0B0E14" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="💬 Comunicação (Discord / WhatsApp)"
                            Height="28" FontSize="11" Padding="12,0" Margin="0,0,4,0"
                            Command="{Binding FilterCommand}" CommandParameter="Comunicação">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterComm}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GlideAccentMintBrush}" />
                                        <Setter Property="Foreground" Value="#0B0E14" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🛡️ Sistema &amp; Glide Hub"
                            Height="28" FontSize="11" Padding="12,0"
                            Command="{Binding FilterCommand}" CommandParameter="Sistema">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterSystem}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GlideAccentMintBrush}" />
                                        <Setter Property="Foreground" Value="#0B0E14" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Lista de Notificações -->
            <ItemsControl ItemsSource="{Binding FilteredNotifications}" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlideCardBorderStyle}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Ícone de Categoria / Serviço -->
                                <Border Width="42" Height="42" CornerRadius="8" Background="#1C2738"
                                        BorderBrush="{StaticResource GlideBorderBrush}" BorderThickness="1"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📩" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServiceId}" Value="steam">
                                                        <Setter Property="Text" Value="🎮" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ServiceId}" Value="discord">
                                                        <Setter Property="Text" Value="💬" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ServiceId}" Value="whatsapp">
                                                        <Setter Property="Text" Value="📱" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ServiceId}" Value="system">
                                                        <Setter Property="Text" Value="🛡️" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Conteúdo da Notificação -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Sender}" Foreground="{StaticResource GlideAccentMintBrush}"
                                                   FontSize="14" FontWeight="Bold" Margin="0,0,10,0" />
                                        <Border Background="#131F30" BorderBrush="{StaticResource GlideBorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource GlideAccentBlueBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource GlideTextPrimaryBrush}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource GlideTextSecondaryBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Timestamp e Ações Individuais -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd/MM • HH:mm}'}"
                                               Foreground="{StaticResource GlideTextMutedBrush}"
                                               FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="✓ Lida" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                                Command="{Binding DataContext.MarkAsReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="🗑️" Style="{StaticResource SecondaryButtonStyle}"
                                                FontSize="10" Padding="8,3" Foreground="{StaticResource GlideDangerBrush}"
                                                Command="{Binding DataContext.DeleteNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}" ToolTip="Excluir Notificação" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
